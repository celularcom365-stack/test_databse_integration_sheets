// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prospect {
  id_prospect Int @id @default(autoincrement())
  interactions Interaction[]
  client Client? 
  type ClientType @relation(fields: [typeId], references: [id_clientType])
  identification String @unique
  name String
  source String
  observation String?
  typeId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model ClientType{
  id_clientType Int @id @default(autoincrement())
  prospects Prospect[]
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
enum OwnerType {
  Client
  Advisor
}
enum gender {
  Masculino
  Femenino
  Otro
}
model Address {
  id_address Int @id @default(autoincrement())
  ownerType OwnerType
  ownerId Int
  main Boolean @default(false)
  coordinates String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@index([ownerType, ownerId])
}
model Contact {
  id_contact Int @id @default(autoincrement())
  ownerType OwnerType
  ownerId Int
  main Boolean @default(false)
  phone String @unique
  name String?
  description String?
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@index([ownerType, ownerId])
}
model Advisor {
  id_advisor Int @id @default(autoincrement())
  interactions Interaction[]
  preSales PreSale[]
  postSales PostSale[]
  reports Report[]
  rosters Roster[]
  user User?
  identification String @unique
  name String
  lastName String
  gender gender
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Interaction {
  id_interaction Int @id @default(autoincrement())
  prospect Prospect @relation(fields: [prospectId], references: [id_prospect])
  advisor Advisor @relation(fields: [advisorId], references: [id_advisor])
  prospectId Int
  advisorId Int
  result String
  observation String
  nextAction DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Client {
  id_client Int @id @default(autoincrement())
  prospect Prospect @relation(fields: [prospectId], references: [id_prospect])
  preSales PreSale[]
  postSales PostSale[]
  prospectId Int @unique
  observation String
  email String @unique
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model PreSale {
  id_preSale Int @id @default(autoincrement())
  client Client @relation(fields: [clientId], references: [id_client])
  advisor Advisor @relation(fields: [advisorId], references: [id_advisor])
  productXPreSales ProductXPreSale[]
  quotations Quotation[]
  clientId Int
  advisorId Int
  closureProbability Int
  result String
  estimatedClosingDate DateTime
  estimatedTotal Decimal @db.Decimal(10,2)
  observation String
  nextAction DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Product {
  id_product Int @id @default(autoincrement())
  type ProductType @relation(fields: [typeId], references: [id_productType])
  productXPreSales ProductXPreSale[]
  commissionDetails CommissionDetail[]
  typeId Int
  name String @unique
  description String?
  havePrice Boolean @default(true)
  price Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model ProductXPreSale {
  id_productXPreSale Int @id @default(autoincrement())
  preSale PreSale @relation(fields: [preSaleId], references: [id_preSale])
  product Product @relation(fields: [productId], references: [id_product])
  preSaleId Int
  productId Int
  quantity Int
  // iva - subtotal
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model ProductType {
  id_productType Int @id @default(autoincrement())
  products Product[]
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model User {
  id_user Int @id @default(autoincrement())
  role Role @relation(fields: [roleId], references: [id_role])
  advisor Advisor? @relation(fields: [advisorId], references: [id_advisor])
  advisorId Int? @unique
  userName String @unique
  email String @unique
  password String
  lastLogin DateTime?
  roleId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Role {
  id_role Int @id @default(autoincrement())
  users User[]
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Quotation {
  id_quotation Int @id @default(autoincrement())
  sale Sale?
  preSale PreSale @relation(fields: [preSaleId], references: [id_preSale])
  preSaleId Int @unique
  state String
  observation String
  applicationDate DateTime @default(now())
  receivedDate DateTime?
  validDate DateTime
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Sale {
  id_sale Int @id @default(autoincrement())
  quotation Quotation @relation(fields: [quotationId], references: [id_quotation])
  dispatches Dispatch[]
  quotationId Int @unique
  saleDate DateTime @default(now())
  startDate DateTime @default(now())
  endDate DateTime?
  contract String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Dispatch {
  id_dispatch Int @id @default(autoincrement())
  sale Sale @relation(fields: [saleId], references: [id_sale])
  saleId Int
  dispatchDate DateTime @default(now())
  address String
  receiver String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model PostSale{
  id_postSale Int @id @default(autoincrement())
  advisor Advisor @relation(fields: [advisorId], references: [id_advisor])
  client Client @relation(fields: [clientId], references: [id_client])
  clientId Int
  advisorId Int
  serviceDate DateTime @default(now())
  observation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Expense {
  id_expense Int @id @default(autoincrement())
  report Report[]
  amountDays Int
  lunch Decimal @db.Decimal(10,2)
  transport Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  observation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Commission {
  id_commission Int @id @default(autoincrement())
  report Report[]
  commissionDetail CommissionDetail[]
  total Decimal @db.Decimal(10,2)
  observation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model CommissionDetail {
  id_commissionDetail Int @id @default(autoincrement())
  product Product @relation(fields: [productId], references: [id_product])
  commission Commission @relation(fields: [commissionId], references: [id_commission])
  amount Int
  percentage Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  productId Int
  commissionId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Report {
  id_report Int @id @default(autoincrement())
  expense Expense @relation(fields: [expenseId], references: [id_expense])
  commission Commission @relation(fields: [commissionId], references: [id_commission])
  advisor Advisor @relation(fields: [advisorId], references: [id_advisor])
  startDate DateTime
  endDate DateTime
  total Decimal @db.Decimal(10,2)
  expenseId Int
  commissionId Int
  advisorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Service {
  id_service Int @id @default(autoincrement())
  rosters Roster[]
  name String @unique
  description String?
  supervisor String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}
model Roster {
  id_roster Int @id @default(autoincrement())
  service Service @relation(fields: [serviceId], references: [id_service])
  advisor Advisor @relation(fields: [advisorId], references: [id_advisor])
  serviceId Int
  advisorId Int
  startDate DateTime
  endDate DateTime
  value Decimal @db.Decimal(10,2)
  modality String
  fixedSalary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}