// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum gender {
  MASCULINO
  FEMENINO
  OTRO
}
enum callState {
  CONTESTO
  NO_CONTESTO
  CORTO
  BUZON
  EQUIVOCADO
}
enum channel {
  LLAMADA
  WHATSAPP
  CORREO
}
enum intResult {
  INTERESADO
  NO_INTERESADO
  NO_ES_TITULAR
  CONTACTAR_OTRO_MOMENTO
  SIN_COBERTURA
  CLIENTE
}
enum UserState {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum BankAccountType {
  SAVINGS
  CHECKING
}
enum DocumentOwnerType {
  PROSPECT
  CLIENT
  ADVISOR
  SALE
  PRESALE
  COMPANY
}
enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

// Database schema here

model User {
  id Int @id @default(autoincrement())
  //
  role Role @relation(fields: [roleId], references: [id])
  advisor Advisor? @relation(fields: [advisorId], references: [id])
  auditLog AuditLog[]

  emailVerification EmailVerification[]
  notification Notification[]
  document Document[]
  terms TermsAcceptance?

  advisorId Int? @unique
  roleId Int
  //
  userName String @unique
  email String @unique
  password String
  lastLogin DateTime?
  emailVerified Boolean @default(false)
  state UserState @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Role {
  id Int @id @default(autoincrement())
  //
  users User[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model EmailVerification{
  id Int @id @default(autoincrement())
  //
  user User @relation(fields: [userId], references: [id])
  //
  userId Int
  token String
  expiresAt DateTime
  used Boolean
  createdAt DateTime @default(now())
}

model TermsAcceptance{
  id Int @id @default(autoincrement())
  //
  user User @relation(fields: [userId], references: [id])
  //
  userId Int @unique
  termsVersion String
  privacyVersion String
  ipAddress String
  userAgent String
  acceptedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
  @@index([userId])
}

model ProspectAssignment {
  id Int @id @default(autoincrement())
  //
  prospect Prospect @relation(fields: [prospectId], references: [id])
  advisor Advisor @relation(fields: [advisorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  advisorId Int
  prospectId Int
  companyId Int
  //
  assignedAt DateTime @default(now())
  endDate DateTime?
  reason String?
  current Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@index([prospectId, companyId, current])
  @@index([advisorId, assignedAt])

}

model Notification {
  id Int @id @default(autoincrement())
  //
  user User? @relation(fields: [userId], references: [id])
  //
  title String
  message String
  read Boolean @default(false)
  userId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model BankAccount {
  id Int @id @default(autoincrement())
  //
  advisor Advisor @relation(fields: [advisorId], references: [id])

  advisorId Int
  //
  bankName String
  accountType BankAccountType
  accountNumber String
  holderName String?
  holderDocument String
  main Boolean @default(false)
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@unique([advisorId, main])
  @@index([advisorId])
}

model Prospect {
  id Int @id @default(autoincrement())
  //
  type ClientType @relation(fields: [typeId], references: [id])
  industry Industry? @relation(fields: [industryId], references: [id])

  contact ProspectContact[]
  interaction Interaction[]
  address ProspectAddress[]
  prospectAssignment ProspectAssignment[]
  client Client?

  typeId Int
  industryId Int?
  //
  identification String? @unique
  name String
  source String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Advisor {
  id Int @id @default(autoincrement())
  //
  interaction Interaction[]
  preSale PreSale[]
  postSale PostSale[]
  reports Report[]
  roster Roster[]
  contact AdvisorContact[]
  address AdvisorAddress[]
  prospectAssignment ProspectAssignment[]
  bankAccount BankAccount[]
  user User?
  //
  identification String @unique
  name String
  lastName String
  gender gender
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model ClientType{
  id Int @id @default(autoincrement())
  //
  prospects Prospect[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model ProspectAddress {
  id Int @id @default(autoincrement())
  //
  prospect Prospect @relation(fields: [ownerId], references: [id])
  city City @relation(fields: [cityId], references: [id])

  cityId Int
  ownerId Int
  //
  main Boolean @default(false)
  coordinates String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model AdvisorAddress {
  id Int @id @default(autoincrement())
  //
  advisor Advisor @relation(fields: [ownerId], references: [id])
  city City @relation(fields: [cityId], references: [id])

  cityId Int
  ownerId Int
  //
  coordinates String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model ProspectContact {
  id Int @id @default(autoincrement())
  //
  prospect Prospect @relation(fields: [ownerId], references: [id])

  ownerId Int
  //
  main Boolean @default(false)
  phone String @unique
  name String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model AdvisorContact {
  id Int @id @default(autoincrement())
  //
  advisor Advisor @relation(fields: [ownerId], references: [id])

  ownerId Int
  //
  main Boolean @default(false)
  phone String @unique
  description String?
  startDate DateTime?
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Interaction {
  id Int @id @default(autoincrement())
  //
  prospect Prospect @relation(fields: [prospectId], references: [id])
  advisor Advisor @relation(fields: [advisorId], references: [id])

  prospectId Int
  advisorId Int
  //
  channel channel
  callState callState
  duration Decimal? @db.Decimal(10,2)
  clientTone String?
  observation String?
  result intResult?
  nextAction DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@index([advisorId, createdAt])
  @@index([prospectId, result])
}

model Client {
  id Int @id @default(autoincrement())
  //
  prospect Prospect? @relation(fields: [prospectId], references: [id])

  preSales PreSale[]
  postSales PostSale[]

  prospectId Int? @unique
  //
  observation String
  email String @unique
  birthDate DateTime
  convertedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model PreSale {
  id Int @id @default(autoincrement())
  //
  client Client @relation(fields: [clientId], references: [id])
  advisor Advisor @relation(fields: [advisorId], references: [id])

  preSalesProduct PreSaleProduct[]
  preSaleState PreSaleState[]
  quotations Quotation[]

  clientId Int
  advisorId Int
  //
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model PreSaleState{
  id Int @id @default(autoincrement())
  //
  preSale PreSale @relation(fields: [preSaleId], references: [id])

  preSaleId Int
  //
  closureProbability Int
  estimatedClosingDate DateTime?
  estimatedTotal Decimal? @db.Decimal(10,2)
  observation String?
  result String?
  main Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model CategoryProduct{
  id Int @id @default(autoincrement())
  //
  products Product[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Product {
  id Int @id @default(autoincrement())
  //
  company Company @relation(fields: [typeId], references: [id])
  category CategoryProduct @relation(fields: [categoryId], references: [id])

  preSalesProduct PreSaleProduct[]
  commissionProduct CommissionProduct[]

  typeId Int
  categoryId Int
  //
  name String @unique
  description String?
  havePrice Boolean @default(true)
  price Decimal? @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model PreSaleProduct {
  id Int @id @default(autoincrement())
  //
  preSale PreSale @relation(fields: [preSaleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  preSaleId Int
  productId Int
  //
  quantity Int
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Company {
  id Int @id @default(autoincrement())
  //
  products Product[]
  prospectAssignment ProspectAssignment[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Quotation {
  id Int @id @default(autoincrement())
  //
  preSale PreSale @relation(fields: [preSaleId], references: [id])

  sale Sale?

  preSaleId Int @unique
  //
  state String
  observation String
  applicationDate DateTime @default(now())
  receivedDate DateTime?
  validDate DateTime
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Sale {
  id Int @id @default(autoincrement())
  //
  quotation Quotation @relation(fields: [quotationId], references: [id])

  dispatches Dispatch[]

  quotationId Int @unique
  //
  saleDate DateTime @default(now())
  startDate DateTime @default(now())
  endDate DateTime?
  contract String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Dispatch {
  id Int @id @default(autoincrement())
  //
  sale Sale @relation(fields: [saleId], references: [id])

  saleId Int
  //
  dispatchDate DateTime @default(now())
  receiver String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model PostSale{
  id Int @id @default(autoincrement())
  //
  advisor Advisor @relation(fields: [advisorId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  clientId Int
  advisorId Int
  //
  serviceDate DateTime @default(now())
  observation String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model ExpenseType{
  id Int @id @default(autoincrement())
  //
  expenses ExpenseDetail[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model ExpenseDetail {
  id Int @id @default(autoincrement())
  //
  type ExpenseType @relation(fields: [typeId], references: [id])
  expense Expense @relation(fields: [expenseId], references: [id])

  typeId Int
  expenseId Int
  //
  amountDays Int
  description String?
  amount Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Expense {
  id Int @id @default(autoincrement())
  //
  report Report[]
  expenseDetail ExpenseDetail[]
  //
  observation String?
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Commission {
  id Int @id @default(autoincrement())
  //
  report Report[]
  commissionProduct CommissionProduct[]
  //
  total Decimal @db.Decimal(10,2)
  observation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model CommissionProduct {
  id Int @id @default(autoincrement())
  //
  product Product @relation(fields: [productId], references: [id])
  commission Commission @relation(fields: [commissionId], references: [id])

  productId Int
  commissionId Int
  //
  amount Decimal @db.Decimal(10,2)
  percentage Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Report {
  id Int @id @default(autoincrement())
  //
  expense Expense @relation(fields: [expenseId], references: [id])
  commission Commission @relation(fields: [commissionId], references: [id])
  advisor Advisor @relation(fields: [advisorId], references: [id])
  
  expenseId Int
  commissionId Int
  advisorId Int
  //
  startDate DateTime
  endDate DateTime
  total Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Roster {
  id Int @id @default(autoincrement())
  //
  advisor Advisor @relation(fields: [advisorId], references: [id])

  advisorId Int
  //
  startDate DateTime
  endDate DateTime
  value Decimal @db.Decimal(10,2)
  modality String
  fixedSalary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Province {
  id Int @id @default(autoincrement())
  //
  cities City[]
  //
  name String @unique
}

model City{
  id Int @id @default(autoincrement())
  //
  province Province @relation(fields: [provinceId], references: [id])

  prospectAddress ProspectAddress[]
  advisorAddress AdvisorAddress[]

  provinceId Int
  //
  name String
}

model Industry {
  id Int @id @default(autoincrement())
  //
  prospects Prospect[]
  //
  name String @unique
  description String?
}

model DocumentType {
  id Int @id @default(autoincrement())
  //
  document Document[]
  //
  name String @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)
}

model Document {
  id Int @id @default(autoincrement())
  //
  user User? @relation(fields: [userId], references: [id])
  type DocumentType @relation(fields: [typeId], references: [id])

  typeId Int
  userId Int?
  //
  ownerType DocumentOwnerType
  ownerId Int
  status DocumentStatus @default(PENDING)
  fileName String?
  fileType String?
  size Int?
  storagePath String?
  validFrom DateTime?
  validUntil DateTime?
  observation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visible Boolean @default(true)

  @@index([ownerType, ownerId])
  @@index([typeId, status])
}

model AuditLog {
  id Int @id @default(autoincrement())
  //
  user User @relation(fields: [userId], references: [id])

  userId Int 
  //
  action String       // CREATE, UPDATE, DELETE
  entity String       // Tabla modificada
  entityId Int?
  
  // Campos específicos del cambio
  fieldName String    // "email", "status", "price"
  oldValue String?
  newValue String?
  
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([entity, entityId, fieldName])
}